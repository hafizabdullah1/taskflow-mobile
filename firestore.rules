rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for the 'tasks' collection
    match /tasks/{taskId} {
      // 1. Read: User must be signed in AND own the task document
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // 2. Create: User must be signed in, own the new document, and provide valid title
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0;

      // 3. Update & Delete: User must be signed in AND own the existing document
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Deny access to any other unspecified collection by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
